{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Accountability Guild design tokens. Reconciles Identity Kit Vol. 01 (brand-surface seven) with the app's functional palette from repo public/ag-refresh/components.css. Source of truth for Claude Design imports and design tooling.",
  "color": {
    "surface": {
      "bg": { "$value": "#FAFAF7", "$type": "color", "$description": "Bone — page background (brand token)" },
      "panel": { "$value": "#FFFFFF", "$type": "color", "$description": "Panel — cards, inputs (brand token)" },
      "panelSoft": { "$value": "#F4F1E9", "$type": "color", "$description": "Muted surface" }
    },
    "ink": {
      "default": { "$value": "#0F0F0E", "$type": "color", "$description": "Ink — primary type (brand token)" },
      "soft": { "$value": "#5C5C58", "$type": "color", "$description": "Ink Soft — secondary type (brand token)" },
      "softer": { "$value": "#8A867E", "$type": "color", "$description": "Subtle type, counters, disabled labels" }
    },
    "line": {
      "default": { "$value": "#E5E2DA", "$type": "color", "$description": "Line — hairlines, borders (brand token)" },
      "soft": { "$value": "#EFEDE5", "$type": "color", "$description": "Soft fills, card headers, skeleton base" },
      "strong": { "$value": "#C9C5B8", "$type": "color", "$description": "Emphasized rules" }
    },
    "brand": {
      "accent": { "$value": "#D8512A", "$type": "color", "$description": "Ember — the one warm beat; focus rings, accent rules (brand token)" },
      "accentSoft": { "$value": "#F0A98A", "$type": "color", "$description": "Ember Soft — tints (brand token)" },
      "accentInk": { "$value": "#6E2810", "$type": "color", "$description": "Deep ember for type on accentSoft grounds" }
    },
    "state": {
      "error": { "$value": "#B83A1F", "$type": "color" },
      "errorSoft": { "$value": "#F4DCD3", "$type": "color" },
      "success": { "$value": "#1F7A4D", "$type": "color" },
      "successSoft": { "$value": "#DCEAE0", "$type": "color" },
      "warning": { "$value": "#B07A1A", "$type": "color" },
      "warningSoft": { "$value": "#F1E5C8", "$type": "color" },
      "info": { "$value": "#2A5C8A", "$type": "color" },
      "infoSoft": { "$value": "#DAE5F0", "$type": "color" }
    }
  },
  "font": {
    "family": {
      "serif": { "$value": ["Newsreader", "Georgia", "serif"], "$type": "fontFamily", "$description": "Display and editorial voice; italic 400 for wordmark, headlines, help text" },
      "sans": { "$value": ["Inter Tight", "-apple-system", "BlinkMacSystemFont", "sans-serif"], "$type": "fontFamily", "$description": "UI controls, body; 600 tracked-caps for GUILD and buttons" },
      "mono": { "$value": ["JetBrains Mono", "ui-monospace", "SFMono-Regular", "monospace"], "$type": "fontFamily", "$description": "Kickers, labels, meta; small tracked uppercase" }
    },
    "style": {
      "displayH1": { "$value": { "fontFamily": "{font.family.serif}", "fontWeight": 400, "fontSize": "clamp(40px, 5vw, 72px)", "letterSpacing": "-0.02em", "lineHeight": 1.0 }, "$type": "typography", "$description": "Masthead h1; italic spans take accent color" },
      "h2": { "$value": { "fontFamily": "{font.family.serif}", "fontWeight": 400, "fontSize": "36px", "letterSpacing": "-0.02em", "lineHeight": 1.05 }, "$type": "typography" },
      "lede": { "$value": { "fontFamily": "{font.family.serif}", "fontSize": "17px", "lineHeight": 1.55, "color": "{color.ink.soft}" }, "$type": "typography" },
      "labelMono": { "$value": { "fontFamily": "{font.family.mono}", "fontSize": "11px", "fontWeight": 600, "letterSpacing": "0.18em", "textTransform": "uppercase", "color": "{color.ink.soft}" }, "$type": "typography", "$description": "Form labels, kickers, TOC links; 0.2em tracking for masthead meta" },
      "buttonLabel": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "13px", "fontWeight": 600, "letterSpacing": "0.14em", "textTransform": "uppercase" }, "$type": "typography" },
      "body": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "14px", "lineHeight": 1.5 }, "$type": "typography" },
      "helpItalic": { "$value": { "fontFamily": "{font.family.serif}", "fontStyle": "italic", "fontSize": "13px", "lineHeight": 1.45, "color": "{color.ink.soft}" }, "$type": "typography", "$description": "Field help, editorial asides" },
      "wordmarkSerif": { "$value": { "fontFamily": "{font.family.serif}", "fontStyle": "italic", "fontWeight": 400 }, "$type": "typography", "$description": "\"Accountability\" in the lockup" },
      "wordmarkSans": { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 600, "letterSpacing": "0.34em", "textTransform": "uppercase" }, "$type": "typography", "$description": "\"GUILD\" in the lockup; ~42% of serif size, baseline-aligned" }
    }
  },
  "dimension": {
    "radius": { "$value": "0px", "$type": "dimension", "$description": "Editorial = sharp corners. No rounded corners on UI surfaces (app icons/avatars excepted)." },
    "fieldHeight": { "$value": "44px", "$type": "dimension", "$description": "Min interactive height (also buttons)" },
    "contentMaxWidth": { "$value": "1240px", "$type": "dimension" },
    "socialCard": { "$value": "1200x630", "$type": "dimension", "$description": "OG/social template size" }
  },
  "motion": {
    "fast": { "$value": "120ms ease", "$type": "duration", "$description": "Hover/focus transitions" },
    "medium": { "$value": "160ms ease", "$type": "duration" }
  }
}
